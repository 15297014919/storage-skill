{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "存储选型业务诉求",
  "type": "object",
  "required": ["scenario", "data_model", "consistency", "query_patterns"],
  "properties": {
    "scenario": {"type": "string", "minLength": 1},
    "data_model": {"type": "string", "enum": ["relation", "kv", "wide_table", "document", "search", "olap", "event_stream", "graph", "vector"]},
    "data_scale_tb": {"type": "number", "minimum": 0},
    "column_count": {"type": "integer", "minimum": 0},
    "read_qps": {"type": "number", "minimum": 0},
    "write_qps": {"type": "number", "minimum": 0},
    "access_density_per_gb": {"type": "number", "minimum": 0},
    "p99_latency_ms": {"type": "number", "minimum": 0},
    "consistency": {"type": "string", "enum": ["strong", "eventual", "none", "unknown"]},
    "transaction_required": {"type": "boolean"},
    "persistence_required": {"type": "boolean"},
    "workload_mode": {"type": "string", "enum": ["online", "nearline", "offline", "unknown"]},
    "query_patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cost_sensitive": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
    "availability": {
      "type": "object",
      "properties": {
        "cross_az": {"type": "boolean"},
        "cross_region": {"type": "boolean"},
        "rto_minutes": {"type": "number", "minimum": 0},
        "rpo_minutes": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "known_risks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
